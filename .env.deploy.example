# ---------------------------------------------------------------------------
# gng — deployment secrets for docker-compose
#
#   cp .env.deploy.example .env
#
# Compose reads `.env` from beside `docker-compose.yml`. This file is the
# template; `.env` holds the real values and is gitignored.
#
# Variables marked REQUIRED have no default — compose refuses to start without
# them rather than silently bringing up an insecure stack.
# ---------------------------------------------------------------------------

# --- Public URLs -----------------------------------------------------------
# REQUIRED. Where customers reach the shop. Include https — this ends up in
# canonical tags, the sitemap, and the event_source_url sent to Meta.
SITE_URL=https://gng.com.bd

# REQUIRED. Public URL of the API. Product image URLs are built from it, so it
# must be reachable from a customer's browser even though page data is fetched
# server-side.
API_PUBLIC_URL=https://api.gng.com.bd

# --- Database --------------------------------------------------------------
POSTGRES_USER=gng
POSTGRES_DB=gng
# REQUIRED. Generate:
#   node -e "console.log(require('crypto').randomBytes(24).toString('base64url'))"
POSTGRES_PASSWORD=

# --- Authentication --------------------------------------------------------
# REQUIRED. Minimum 32 characters. Rotating this invalidates every admin
# session immediately, which is the correct response to a suspected leak.
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=

# Refresh cookies must be HTTPS-only in production. Leave true.
COOKIE_SECURE=true

# Only while bringing the shop up on a bare IP, before a domain is pointed here.
#
# Let's Encrypt will not issue a certificate for an IP address, so there is no
# HTTPS yet — and a Secure cookie is never sent back over plain HTTP, which makes
# the admin login appear to succeed and then bounce straight back to sign-in.
#
# It is a separate switch because the guard it lifts is right: a session cookie
# in clear text can be read by anyone on the network path. Set BOTH this and
# COOKIE_SECURE=false, and turn them back the moment a domain and certificate
# exist. The API warns on every boot while this is on.
# Applies to BOTH the API and the admin panel — the panel sets its own session
# cookies, so one without the other still leaves login broken.
# ALLOW_INSECURE_COOKIES=true
# Set only if the API and the admin panel share a parent domain and you need the
# cookie scoped to it. Leave blank otherwise.
COOKIE_DOMAIN=

# --- Reverse proxy ---------------------------------------------------------
# Number of proxies in front of the API. 1 for a single Nginx or Caddy; 2 if
# Cloudflare sits in front of that. Wrong values break rate limiting: too low
# and every visitor shares one bucket, too high and a client can spoof its IP.
TRUST_PROXY_HOPS=1

# Set to true ONLY when nothing proxies the API — its port is published straight
# to the internet, with no Caddy or nginx in front. Then TRUST_PROXY_HOPS=0 is
# the correct value and this says so out loud.
#
# Do NOT raise the hops instead: Express would trust an X-Forwarded-For header
# that any caller can write, and anyone could spoof an address to walk past the
# rate limits on login and checkout.
# NO_REVERSE_PROXY=true

LOG_LEVEL=info

# --- Rate limits -----------------------------------------------------------
# Leave these alone unless you have a reason. The defaults in the API's config
# are already sized for this country, and the reasoning is written out there.
#
# The short version: every public limit keys on the shopper's IP address, and
# in Bangladesh an address is not a person — the mobile carriers run
# carrier-grade NAT, so hundreds of real customers arrive from a handful of
# addresses. On a shop whose traffic comes from a Facebook ad, on phones, that
# is the normal case. Numbers sized for one visitor turn a successful ad into a
# wall of "too many requests" for customers who did nothing wrong, and they do
# it at the end of the funnel — pricing the cart, placing the order.
#
# Raising them is safe. LOWERING them is what breaks a busy day.
#
# RATE_LIMIT_MAX=4000            # backstop; browsing never reaches it
# CHECKOUT_RATE_LIMIT_MAX=150    # orders per address per 15 min
# QUOTE_RATE_LIMIT_MAX=600       # cart pricing, search, incomplete-checkout saves
# TRACK_RATE_LIMIT_MAX=300       # order tracking
# AUTH_RATE_LIMIT_MAX=10         # login — keyed by address AND email, keep tight

# --- Email (password reset) ------------------------------------------------
# Used for exactly one message: the 6-digit code sent when an admin uses
# "Forgot your password?".
#
# OPTIONAL. Leave SMTP_HOST blank and the code still goes out over Telegram,
# which this shop already has configured. Email is the second channel, not the
# only one — and it is the one more likely to fail quietly, because a shop's own
# VPS sending a six-digit number to Gmail looks a lot like phishing and lands in
# spam often enough that account recovery should not depend on it alone.
#
# These live here rather than in the admin panel on purpose. This is the way
# back INTO the panel, so its configuration must not sit behind the panel: one
# bad edit and the only route back in is gone, with no login left to fix it.
#
# Gmail: create an App Password (Google account → Security → 2-Step
# Verification → App passwords). Your normal Google password will not work.
#   SMTP_HOST=smtp.gmail.com
#   SMTP_PORT=587
#   SMTP_USER=you@gmail.com
#   SMTP_PASSWORD=the-16-character-app-password
#
# For deliverability that does not depend on Gmail's mood, use a sending
# service (Resend, Brevo, Postmark) and verify the shop's own domain.
#
# Port 465 switches to implicit TLS automatically; anything else uses STARTTLS.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
# What the recipient sees in "From". Blank falls back to SMTP_USER.
SMTP_FROM=

# --- First admin -----------------------------------------------------------
# Used once by `npm run db:seed`. Delete both values afterwards — leaving a
# working password in a file on the server serves no purpose.
SEED_ADMIN_EMAIL=owner@gng.com.bd
SEED_ADMIN_PASSWORD=
SEED_ADMIN_NAME=Owner

# --- Contact ---------------------------------------------------------------
# Digits only, country code, no `+`.
NEXT_PUBLIC_WHATSAPP_NUMBER=8801700000000
NEXT_PUBLIC_HOTLINE=09612000000

# --- Meta / Facebook -------------------------------------------------------
# Nothing to set here — tracking is configured from the admin dashboard at
# /admin/marketing after the stack is up, and stored in the database.

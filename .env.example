# ---------------------------------------------------------------------------
# gng storefront — environment
#
# Copy to `.env.local` for development, or set these as real environment
# variables in production. Validated at module load (src/lib/api/config.ts): a
# missing required value throws on the first render rather than quietly serving
# an empty shop, which is the worst possible outcome while you are paying for
# traffic.
# ---------------------------------------------------------------------------

# --- Backend ---------------------------------------------------------------
# Base URL of the gng API. REQUIRED.
#
# Deliberately NOT prefixed `NEXT_PUBLIC_`: the browser never calls the API
# directly. Every request goes through this Next server, which means the API can
# sit on a private network and needs no CORS rule for the storefront at all.
#
# NOTE: this is read at BUILD time as well as at runtime — `next.config.ts`
# derives the `next/image` remote allowlist from it. If the API host differs
# between build and run, set IMAGE_HOST too (below), or product photos will be
# rejected by the image optimiser with a 400.
API_URL=http://localhost:4000

# Fail a request rather than let a hung backend hold a page render open.
API_TIMEOUT_MS=8000

# Default ISR window, in seconds, for catalogue reads. Admin edits revalidate
# on demand, so this is a safety net rather than the primary freshness
# mechanism — it does not need to be small.
API_REVALIDATE_SECONDS=300

# Origin serving product images, if not the API itself (a CDN or object store).
# Build-time only. Leave blank to derive from API_URL.
IMAGE_HOST=

# --- This site -------------------------------------------------------------
# Public origin, used for canonical URLs, the sitemap, and the `event_source_url`
# sent to Meta. Must match what customers actually type, including https.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Contact ---------------------------------------------------------------
# Shown in the footer and behind the floating WhatsApp button. Digits only,
# with country code and no `+`.
NEXT_PUBLIC_WHATSAPP_NUMBER=8801700000000
NEXT_PUBLIC_HOTLINE=09612000000

# --- Meta / Facebook -------------------------------------------------------
# Nothing to set here.
#
# The pixel id, Conversions API token, test event code and domain-verification
# code are all configured from the admin dashboard at /admin/marketing and stored
# in the database. They were environment variables once; a `NEXT_PUBLIC_*` value
# is inlined into the client bundle at build time, which made "connect your
# pixel" a code deploy instead of a form.
#
# The Conversions API token never reaches this server at all — the API sends the
# server-side Purchase event itself, from the one process that holds the token.

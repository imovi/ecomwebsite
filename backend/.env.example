# ---------------------------------------------------------------------------
# gng backend — environment
#
# Copy to `.env` and fill in. Every variable below is validated by Zod at boot
# (src/config/env.ts); a missing or malformed value aborts startup immediately
# rather than surfacing as a runtime failure later.
# ---------------------------------------------------------------------------

# --- Runtime ---------------------------------------------------------------
NODE_ENV=development
PORT=4000
# Public base URL of this API. Used for absolute file URLs.
API_URL=http://localhost:4000
# Comma-separated list of browser origins allowed to call this API.
CORS_ORIGINS=http://localhost:3000
# Trust N reverse proxies in front of the app (Nginx, ALB, Cloudflare).
# MUST be > 0 in production or rate limiting sees the proxy IP for everyone.
TRUST_PROXY_HOPS=0

# --- Logging ---------------------------------------------------------------
# fatal | error | warn | info | debug | trace
LOG_LEVEL=debug
# Pretty-print logs. Never enable in production — it costs throughput and
# breaks structured log ingestion.
LOG_PRETTY=true

# --- Database --------------------------------------------------------------
# `postgres` or `pglite`.
#
# This template is for LOCAL DEVELOPMENT, so it defaults to `pglite` — an
# embedded Postgres that needs no server installed. It runs the same migrations
# and enforces the same constraints, which is also what the test suite uses.
#
# Production sets `postgres` with a real DATABASE_URL; see docker-compose.yml and
# ../.env.deploy.example. Never run pglite in production — it is a single-process
# embedded database with no network access and no replication.
DATABASE_DRIVER=pglite
DATABASE_URL=postgres://gng:gng@localhost:5432/gng
DATABASE_SSL=false
DATABASE_POOL_MAX=10
DATABASE_POOL_IDLE_TIMEOUT_MS=30000
DATABASE_CONNECTION_TIMEOUT_MS=10000
# Directory used when DATABASE_DRIVER=pglite. Relative paths resolve from the
# backend root. Use `memory://` for an ephemeral database.
PGLITE_DATA_DIR=./.pglite

# --- Authentication --------------------------------------------------------
# Signing secret for access tokens. Minimum 32 characters.
# Generate: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=replace-me-with-a-long-random-string-min-32-chars
JWT_ISSUER=gng-api
JWT_AUDIENCE=gng-admin
# Access tokens are short-lived by design; the refresh token carries longevity.
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=14
# Cookie attributes for the refresh token.
COOKIE_DOMAIN=
COOKIE_SECURE=false

# --- Rate limiting ---------------------------------------------------------
RATE_LIMIT_WINDOW_MINUTES=15
RATE_LIMIT_MAX=300
# Deliberately tight: this window guards the login endpoint.
AUTH_RATE_LIMIT_WINDOW_MINUTES=15
AUTH_RATE_LIMIT_MAX=10
# Public checkout — the only unauthenticated write in the API, and the obvious
# target for order spam on a store where placing an order costs nothing.
CHECKOUT_RATE_LIMIT_WINDOW_MINUTES=15
CHECKOUT_RATE_LIMIT_MAX=20
# Quoting is read-only, so it gets a looser ceiling.
QUOTE_RATE_LIMIT_MAX=120
# The "test connection" buttons on the Integrations page, per minute. Each press
# calls Telegram or Google, so this protects the shop's own quota.
INTEGRATION_TEST_RATE_LIMIT_MAX=10
# Lock an admin account after this many consecutive failed logins.
LOGIN_MAX_FAILED_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15

# --- Uploads ---------------------------------------------------------------
# `local` today. The StorageDriver interface exists so S3/R2 can be added
# without touching call sites.
STORAGE_DRIVER=local
UPLOAD_DIR=./uploads
UPLOAD_MAX_FILE_SIZE_MB=5
UPLOAD_MAX_FILES=10

# --- Email (password reset) ------------------------------------------------
# The only message this API sends: the 6-digit code behind "Forgot your
# password?". All optional — with no host the code still goes to Telegram.
#
# Here rather than in store settings because this is the way back into the
# panel, and its configuration must not live behind the panel. See lib/mail.
#
# Gmail needs an App Password, not your account password. Port 465 uses
# implicit TLS; anything else uses STARTTLS.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
# Blank falls back to SMTP_USER.
SMTP_FROM=

# --- Seeding ---------------------------------------------------------------
# Used by `npm run db:seed` to create the first super admin.
SEED_ADMIN_EMAIL=admin@gng.com.bd
SEED_ADMIN_PASSWORD=
SEED_ADMIN_NAME=Super Admin

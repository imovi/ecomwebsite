# gng — reverse proxy and HTTPS.
#
#   sudo cp deploy/Caddyfile.example /etc/caddy/Caddyfile
#   sudo nano /etc/caddy/Caddyfile      # replace both domains
#   sudo systemctl reload caddy
#
# Caddy obtains and renews Let's Encrypt certificates on its own — there is no
# certbot step and nothing to remember to renew.
#
# Point DNS at this server BEFORE reloading: certificate issuance is validated
# over HTTP, so it fails against a domain that does not resolve here yet.

gng.com.bd {
	# The storefront and the admin panel. Everything a browser talks to.
	reverse_proxy 127.0.0.1:3000 {
		# OVERWRITE the forwarded chain, never append to it.
		#
		# By default a proxy appends the address it saw to whatever the client
		# sent, so `X-Forwarded-For: 9.9.9.9` from a browser arrives upstream as
		# `9.9.9.9, <real address>` — and anything reading the FIRST entry is
		# reading a value the client wrote. The storefront forwards that address
		# to the API, which keys its per-shopper rate limits on it, so a forged
		# entry there means no limit at all: on a cash-on-delivery store, order
		# spam that reserves real stock.
		#
		# Replacing the header leaves exactly one entry, and it is one this proxy
		# observed on a connection it terminated. The storefront reads the last
		# entry as well, so either half of this holds the line on its own.
		#
		# Behind Cloudflare or another proxy, take its trusted header instead:
		#   header_up X-Forwarded-For {http.request.header.CF-Connecting-IP}
		header_up X-Forwarded-For {http.request.remote.host}

		# Deleted, never forwarded. `X-Customer-Ip` is a name only the storefront
		# and the API use between themselves: the storefront reads the address
		# Caddy recorded above and re-sends it under this name, and the API
		# honours it only from a caller on the private network.
		#
		# Nothing stops a visitor putting that header on their own request. It
		# would not be trusted today — no public route reaches the code that
		# reads it — but that is an invariant held together by this file and the
		# Express routers agreeing, not by anything that would fail loudly if
		# someone later exposed one more path. Stripping it at the edge makes the
		# guarantee structural: the header cannot arrive from outside at all.
		header_up -X-Customer-Ip
	}

	encode gzip zstd

	header {
		# Sent by the proxy rather than the app so they cover static assets too.
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		# The admin panel shows customer names, phones and addresses.
		X-Frame-Options "SAMEORIGIN"
	}
}

api.gng.com.bd {
	# TWO paths are public, and nothing else. Every other API route is called
	# server-to-server by the storefront over the private Docker network, so
	# exposing them here would widen the attack surface for no benefit.
	handle /uploads/* {
		reverse_proxy 127.0.0.1:4000

		header {
			# Uploaded files are content-addressed: the name changes when the
			# image does, so they can be cached hard.
			Cache-Control "public, max-age=31536000, immutable"
			X-Content-Type-Options "nosniff"
		}
	}

	# The courier's delivery-status webhook. It has to be reachable from their
	# servers, so it cannot live on the private network like the rest of the API.
	#
	# It is safe to expose because it is narrow by construction: a bearer secret
	# generated in the panel guards it, a blank secret refuses everything, and the
	# only thing it can do is move a parcel this shop already handed over. Leave
	# it out and delivery updates fall back to the ten-minute poll — slower, but
	# nothing breaks.
	handle /api/v1/webhooks/* {
		reverse_proxy 127.0.0.1:4000 {
			# Same reason as the storefront block above. This endpoint is guarded
			# by a bearer secret and rate limited on failures, and both defences
			# key on the caller's address — a forgeable one would let an
			# anonymous caller guess at the secret without ever being throttled.
			header_up X-Forwarded-For {http.request.remote.host}
			# See the storefront block above.
			header_up -X-Customer-Ip
		}

		header {
			# Never cached and never indexed: this is an inbound machine endpoint.
			Cache-Control "no-store"
			X-Robots-Tag "noindex"
		}
	}

	handle {
		respond 404
	}
}

# Optional: send www to the apex so search engines see one site, not two.
# www.gng.com.bd {
# 	redir https://gng.com.bd{uri} permanent
# }
